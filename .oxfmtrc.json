{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "singleAttributePerLine": false,
  "insertFinalNewline": true,
  "sortImports": true,
  "sortPackageJson": true,
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/.vinxi/**",
    "**/.nitro/**",
    "**/.agents/**",
    "**/build/**",
    "**/.tanstack/**",
    "**/.coverage/**",
    "**/nix/store/**",
    "**/.pnpm-store/**",
    "**/packages/types/**",
    "**/packages/wasm/pkg/**",
    "**/generated/**",
    "**/generated.ts",
    "**/pnpm-lock.yaml",
    "**/src/routeTree.gen.ts",
    "**/.output/**",
    "**/secrets.yml",
    "**/secrets-prod.yml"
  ]
}
