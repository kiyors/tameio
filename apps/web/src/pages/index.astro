---
import '@fontsource-variable/geist';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Keiri — Identity Calibration</title>
    <style>
      :root {
        --paper: #f5f6f2;
        --paper-deep: #e9ebe4;
        --ink: #151918;
        --muted: #66706c;
        --rule: #cbd0ca;
        --treasury: #315f56;
        --treasury-bright: #b8e2d2;
        --surface: var(--paper);
        --surface-ink: var(--ink);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        min-width: 320px;
        color: var(--ink);
        background:
          linear-gradient(90deg, transparent 0 23px, rgba(21, 25, 24, .055) 24px, transparent 25px) 0 0 / 48px 100%,
          var(--paper);
        font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      button, a { font: inherit; }
      button:focus-visible, a:focus-visible {
        outline: 3px solid var(--treasury);
        outline-offset: 3px;
      }

      .shell { width: min(1420px, calc(100% - 40px)); margin: 0 auto; }
      .topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 68px;
        border-bottom: 1px solid var(--rule);
        font-size: 12px;
        letter-spacing: .11em;
        text-transform: uppercase;
      }
      .topline strong { font-weight: 670; }
      .topline span { color: var(--muted); }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(270px, .5fr);
        gap: 70px;
        padding: clamp(70px, 11vw, 154px) 0 86px;
        align-items: end;
      }
      .eyebrow {
        display: flex;
        align-items: center;
        gap: 11px;
        margin: 0 0 30px;
        color: var(--treasury);
        font-size: 12px;
        font-weight: 650;
        letter-spacing: .13em;
        text-transform: uppercase;
      }
      .eyebrow::before { content: ""; width: 26px; height: 2px; background: currentColor; }
      h1 {
        max-width: 880px;
        margin: 0;
        font-size: clamp(58px, 10vw, 142px);
        font-weight: 520;
        letter-spacing: -.078em;
        line-height: .78;
      }
      h1 span {
        display: block;
        margin: .25em 0 0 .74em;
        color: var(--treasury);
        font-size: .31em;
        font-weight: 460;
        letter-spacing: -.035em;
        line-height: 1;
      }
      .brief {
        padding: 22px 0 3px 24px;
        border-left: 1px solid var(--ink);
      }
      .brief p { margin: 0; color: #39403d; font-size: 16px; line-height: 1.55; }
      .brief small { display: block; margin-top: 26px; color: var(--muted); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }

      .controls-wrap {
        position: sticky;
        top: 0;
        z-index: 10;
        border-block: 1px solid var(--rule);
        background: color-mix(in srgb, var(--paper) 93%, transparent);
        backdrop-filter: blur(18px);
      }
      .controls {
        display: flex;
        min-height: 70px;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }
      .controls-label { color: var(--muted); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
      .segmented { display: flex; align-items: center; gap: 6px; }
      .surface-button {
        min-width: 90px;
        min-height: 38px;
        padding: 8px 14px;
        border: 1px solid transparent;
        border-radius: 999px;
        color: var(--muted);
        background: transparent;
        cursor: pointer;
        font-size: 12px;
      }
      .surface-button[aria-pressed="true"] { border-color: var(--ink); color: var(--ink); background: #fff; }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1px;
        margin: 72px 0 110px;
        background: var(--rule);
        border: 1px solid var(--rule);
      }
      .card {
        position: relative;
        min-width: 0;
        background: var(--paper);
        transition: background-color .35s ease, color .35s ease;
      }
      .card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 55px;
        padding: 0 22px;
        border-bottom: 1px solid var(--rule);
        font-size: 11px;
        letter-spacing: .11em;
        text-transform: uppercase;
      }
      .card-head span:last-child { color: var(--muted); }
      .recommended { color: var(--treasury); font-weight: 680; }
      .stage {
        display: grid;
        place-items: center;
        min-height: clamp(300px, 38vw, 500px);
        color: var(--surface-ink);
        background: var(--surface);
        transition: background-color .35s ease, color .35s ease;
      }
      .mark {
        width: clamp(126px, 15vw, 208px);
        aspect-ratio: 1;
        color: inherit;
        background: currentColor;
        -webkit-mask: var(--src) center / contain no-repeat;
        mask: var(--src) center / contain no-repeat;
        -webkit-mask-mode: alpha;
        mask-mode: alpha;
        transition: transform .6s cubic-bezier(.16, 1, .3, 1);
      }
      .card:hover .mark { transform: scale(1.055); }
      .card-copy { min-height: 190px; padding: 28px 30px 26px; }
      .card-copy h2 { margin: 0 0 12px; font-size: 25px; font-weight: 590; letter-spacing: -.035em; }
      .card-copy p { max-width: 570px; min-height: 50px; margin: 0; color: #4e5753; font-size: 14px; line-height: 1.55; }
      .card-foot { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-top: 27px; }
      .sizes { display: flex; align-items: end; gap: 13px; color: var(--ink); }
      .mini {
        display: inline-block;
        width: var(--size);
        aspect-ratio: 1;
        background: currentColor;
        -webkit-mask: var(--src) center / contain no-repeat;
        mask: var(--src) center / contain no-repeat;
        -webkit-mask-mode: alpha;
        mask-mode: alpha;
      }
      .download { color: var(--ink); font-size: 12px; text-decoration: underline; text-underline-offset: 4px; }

      .lockup-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        margin-bottom: 120px;
        border: 1px solid var(--rule);
        background: var(--rule);
      }
      .lockup-copy { padding: clamp(34px, 6vw, 72px); background: var(--paper-deep); }
      .lockup-copy h2 { margin: 0 0 22px; font-size: clamp(34px, 5vw, 67px); font-weight: 520; letter-spacing: -.06em; line-height: .95; }
      .lockup-copy p { max-width: 520px; margin: 0; color: #48514d; line-height: 1.6; }
      .lockup-copy a { display: inline-block; margin-top: 36px; color: var(--ink); font-size: 13px; }
      .lockup-stage { display: grid; place-items: center; min-height: 390px; padding: 45px; color: #f5f6f2; background: var(--treasury); }
      .lockup-mark {
        width: min(100%, 440px);
        aspect-ratio: 3.6;
        background: currentColor;
        -webkit-mask: url("/keiri-wordmark.svg") center / contain no-repeat;
        mask: url("/keiri-wordmark.svg") center / contain no-repeat;
        -webkit-mask-mode: alpha;
        mask-mode: alpha;
      }
      footer { display: flex; justify-content: space-between; gap: 24px; padding: 0 0 38px; color: var(--muted); font-size: 11px; letter-spacing: .09em; text-transform: uppercase; }

      [data-surface="ink"] { --surface: #141817; --surface-ink: #f2f4ef; }
      [data-surface="treasury"] { --surface: #315f56; --surface-ink: #f1f5ef; }

      @media (max-width: 820px) {
        .hero { grid-template-columns: 1fr; gap: 50px; }
        .hero h1 span { margin-left: .06em; }
        .grid, .lockup-section { grid-template-columns: 1fr; }
        .controls { align-items: flex-start; flex-direction: column; padding: 14px 0; }
        .segmented { width: 100%; }
        .surface-button { flex: 1; min-width: 0; }
      }
      @media (max-width: 520px) {
        .shell { width: min(100% - 24px, 1420px); }
        .topline span { display: none; }
        .hero { padding-top: 74px; }
        .grid { margin-top: 38px; }
        .stage { min-height: 280px; }
        .card-copy { padding-inline: 20px; }
        footer { flex-direction: column; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
      }
    </style>
  </head>
  <body data-surface="paper">
    <header class="shell topline">
      <strong>Keiri / Identity calibration</strong>
      <span>From receipt to record</span>
    </header>

    <main>
      <section class="shell hero">
        <div>
          <p class="eyebrow">Logo exploration / 2026</p>
          <h1>Keiri<span>経理 · accounting & bookkeeping</span></h1>
        </div>
        <div class="brief">
          <p>Six marks built around financial memory: receipts become records, records reconcile, and shared balances settle quietly.</p>
          <small>Monochrome first · 16px tested · SVG native</small>
        </div>
      </section>

      <div class="controls-wrap">
        <div class="shell controls">
          <span class="controls-label">Test every mark on a surface</span>
          <div class="segmented" aria-label="Preview surface">
            <button class="surface-button" type="button" data-value="paper" aria-pressed="true">Porcelain</button>
            <button class="surface-button" type="button" data-value="ink" aria-pressed="false">Ink</button>
            <button class="surface-button" type="button" data-value="treasury" aria-pressed="false">Treasury</button>
          </div>
        </div>
      </div>

      <section class="shell grid" aria-label="Logo concepts">
        <article class="card" style="--src: url('/keiri-mark.svg')">
          <div class="card-head"><span class="recommended">Recommended</span><span>Closed balance</span></div>
          <div class="stage"><span class="mark" role="img" aria-label="Closed Balance logo"></span></div>
          <div class="card-copy">
            <h2>Closed Balance</h2>
            <p>The foundational ideas of Keiri: an open account reconciled and balanced to completion.</p>
            <div class="card-foot"><div class="sizes" aria-label="Small size test"><i class="mini" style="--size:16px"></i><i class="mini" style="--size:24px"></i><i class="mini" style="--size:38px"></i></div><a class="download" href="/keiri-mark.svg" download>SVG ↓</a></div>
          </div>
        </article>

        <article class="card" style="--src: url('/02-smart-merge.svg')">
          <div class="card-head"><span>Direction 02</span><span>Node system</span></div>
          <div class="stage"><span class="mark" role="img" aria-label="Smart Merge logo"></span></div>
          <div class="card-copy">
            <h2>Smart Merge</h2>
            <p>Two independent transaction streams cross-check, converge, and leave as one verified record—the core reconciliation promise.</p>
            <div class="card-foot"><div class="sizes" aria-label="Small size test"><i class="mini" style="--size:16px"></i><i class="mini" style="--size:24px"></i><i class="mini" style="--size:38px"></i></div><a class="download" href="/02-smart-merge.svg" download>SVG ↓</a></div>
          </div>
        </article>

        <article class="card" style="--src: url('/03-receipt-fold.svg')">
          <div class="card-head"><span>Direction 03</span><span>Line + geometry</span></div>
          <div class="stage"><span class="mark" role="img" aria-label="Receipt Fold logo"></span></div>
          <div class="card-copy">
            <h2>Receipt Fold</h2>
            <p>A receipt reduced to its essential shape. The folded corner signals recognition; the irregular edge preserves its physical origin.</p>
            <div class="card-foot"><div class="sizes" aria-label="Small size test"><i class="mini" style="--size:16px"></i><i class="mini" style="--size:24px"></i><i class="mini" style="--size:38px"></i></div><a class="download" href="/03-receipt-fold.svg" download>SVG ↓</a></div>
          </div>
        </article>

        <article class="card" style="--src: url('/04-shared-settlement.svg')">
          <div class="card-head"><span>Direction 04</span><span>Connected nodes</span></div>
          <div class="stage"><span class="mark" role="img" aria-label="Shared Settlement logo"></span></div>
          <div class="card-copy">
            <h2>Shared Settlement</h2>
            <p>Three people move through one ledger and settle into balance. The lower curve reads equally as a smile and a stable bowl.</p>
            <div class="card-foot"><div class="sizes" aria-label="Small size test"><i class="mini" style="--size:16px"></i><i class="mini" style="--size:24px"></i><i class="mini" style="--size:38px"></i></div><a class="download" href="/04-shared-settlement.svg" download>SVG ↓</a></div>
          </div>
        </article>

        <article class="card" style="--src: url('/05-tally-matrix.svg')">
          <div class="card-head"><span>Direction 05</span><span>Dot matrix</span></div>
          <div class="stage"><span class="mark" role="img" aria-label="Tally Matrix logo"></span></div>
          <div class="card-copy">
            <h2>Tally Matrix</h2>
            <p>Rounded ledger cells assemble into a tau. The detached cell suggests data arriving locally before joining the financial record.</p>
            <div class="card-foot"><div class="sizes" aria-label="Small size test"><i class="mini" style="--size:16px"></i><i class="mini" style="--size:24px"></i><i class="mini" style="--size:38px"></i></div><a class="download" href="/05-tally-matrix.svg" download>SVG ↓</a></div>
          </div>
        </article>

        <article class="card" style="--src: url('/06-local-orbit.svg')">
          <div class="card-head"><span>Direction 06</span><span>Layered lines</span></div>
          <div class="stage"><span class="mark" role="img" aria-label="Local Orbit logo"></span></div>
          <div class="card-copy">
            <h2>Local Orbit</h2>
            <p>Fast local data moves around a stable core. Broken rings keep the system open, active, and free from generic coin symbolism.</p>
            <div class="card-foot"><div class="sizes" aria-label="Small size test"><i class="mini" style="--size:16px"></i><i class="mini" style="--size:24px"></i><i class="mini" style="--size:38px"></i></div><a class="download" href="/06-local-orbit.svg" download>SVG ↓</a></div>
          </div>
        </article>
      </section>

      <section class="shell lockup-section" aria-labelledby="lockup-title">
        <div class="lockup-copy">
          <p class="eyebrow">Leading system</p>
          <h2 id="lockup-title">A mark with somewhere to live.</h2>
          <p>The Closed Balance pairs naturally with the dashboard’s existing Geist typography, survives monochrome UI states, and still has a story at large scale.</p>
          <a href="/keiri-wordmark.svg" download>Download complete lockup ↓</a>
        </div>
        <div class="lockup-stage"><span class="lockup-mark" role="img" aria-label="Keiri wordmark lockup"></span></div>
      </section>
    </main>

    <footer class="shell">
      <span>Keiri identity study</span>
      <span>Editable vector assets · currentColor ready</span>
    </footer>

    <script>
      const buttons = document.querySelectorAll(".surface-button");
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          document.body.dataset.surface = button.dataset.value;
          buttons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
        });
      });
    </script>
  </body>
</html>
